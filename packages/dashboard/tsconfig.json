{
  // Tests (bun:test, happy-dom), the build script, the e2e script and the UI (ui/, React) see Bun and DOM types; the root pass skips this package.
  "extends": "../../tsconfig.json",
  "compilerOptions": { "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx", "baseUrl": ".", "paths": { "@/*": ["./ui/*"] } },
  "include": ["src", "ui", "e2e", "build.ts"],
  "exclude": []
}
