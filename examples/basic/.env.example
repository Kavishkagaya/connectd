# Copy to .env (gitignored): one file for your app and connectd. `connectd dev` gives the
# runtime only the names the connections and oc.config.ts read; DATABASE_URL and the like stay yours.
# `connectd init` adds the root key and CONNECTD_URL below; `connectd dev` adds the app's dev keys.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EVENTS_URL=http://localhost:3000/api/connectd
APP_ORIGIN=http://localhost:3000
