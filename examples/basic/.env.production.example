# Copy to .env.production (or .env.staging for `connectd deploy --env staging`; gitignored) for `bun run deploy` (or set these in the shell, e.g. in CI).
# deploy prints which names it sends and pushes only those the project reads, as Worker secrets.
# Production values only: deploy refuses the dev ones and generates its own runtime keys.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: deploy generates the events secret (and the API key) on the first deploy and prints them
# once for your app. Set them here only to choose them yourself (CI must: `connectd keys` makes them).
# CONNECTD_EVENTS_SECRET=whsec_...
