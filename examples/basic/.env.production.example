# Copy to .env.production (gitignored) for `bun run deploy` (or set these in the shell, e.g. in CI).
# deploy prints which names it sends and pushes only those the project reads, as Worker secrets.
# Production values only: deploy refuses the dev ones and generates its own runtime keys.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Needed when EVENTS_URL is set: whsec_ + base64 of 32 random bytes (openssl rand -base64 32); give your app the same value.
# CONNECTD_EVENTS_SECRET=whsec_...
