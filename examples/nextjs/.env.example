# Copy to .env (gitignored): one file for the Next app and connectd.
# The Next app's origin: oc.config.ts builds sessions.origins and events.url from it.
APP_URL=http://localhost:3000
# A GitHub OAuth app (github.com/settings/developers), callback URL http://localhost:8787/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# connectd init adds CONNECTD_URL and dev's keys (CONNECTD_API_KEY, CONNECTD_EVENTS_SECRET, ...) below.
