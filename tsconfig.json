{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "types": [
      "bun"
    ],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "packages/*/src",
    "scripts/*.ts",
    "examples/*/*.ts",
    "examples/*/src/**/*.ts"
  ],
  "exclude": [
    "packages/kernel/src/drivers/do.ts",
    "packages/runtime/src/cloudflare.ts",
    "packages/cloudflare/src/worker.ts",
    "packages/connect",
    "packages/cli/src/runtime-cloudflare.ts",
    "packages/cli/src/kernel-do.ts",
    "packages/dashboard",
    "examples/nextjs"
  ]
}
