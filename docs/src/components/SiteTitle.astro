---
// The wordmark: "connect" + the daemon's "d", highlighted (connectd = the connect daemon).
import { logos } from "virtual:starlight/user-images";
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex" aria-label="connectd, home">
  {logos.dark && <img class="light:sl-hidden" alt="" src={logos.dark.src} width="28" height="28" />}
  {logos.light && <img class="dark:sl-hidden" alt="" src={logos.light.src} width="28" height="28" />}
  <span class="oc-wordmark" translate="no" aria-hidden="true">connect<span class="oc-d">d</span></span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
  img {
    width: 1.75rem;
    height: 1.75rem;
  }
  .oc-wordmark {
    font: 600 1.05rem/1 var(--sl-font-mono);
    letter-spacing: -0.02em;
    color: var(--oc-text);
  }
  .oc-d {
    background: var(--oc-signal);
    color: #16171a;
    padding: 0.05em 0.12em;
    margin-inline-start: 0.04em;
    border-radius: 0.15em;
  }
</style>
